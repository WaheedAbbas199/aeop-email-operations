# Copy to .env  (never commit the real .env). Everything is optional for a local run.
AEOP_ENV=development            # development | production (production requires SECRET_KEY, disables signup + auto table creation)
HOST=127.0.0.1
PORT=8000
BASE_URL=http://localhost:8000  # public URL; must be https:// for provider webhooks / OAuth redirects in production
SECRET_KEY=                     # REQUIRED in production (random 48+ chars). Dev: auto-generated into data/.secret_key
DATABASE_URL=                   # default: SQLite in ./data. Postgres: postgresql+psycopg://user:pass@host:5432/aeop (pip install "psycopg[binary]")
AEOP_AUTO_CREATE_TABLES=        # default true in dev, false in production (then run: alembic upgrade head)
ALLOW_SIGNUP=true               # self-service sign-up creates a NEW isolated organization. Set false in production.
AEOP_ENABLE_DEMO=true           # synthetic demo data loader
ADMIN_EMAIL=admin@aeop.local    # first-run administrator
ADMIN_PASSWORD=                 # if empty a random password is written to data/first_run_credentials.txt (never printed)
COOKIE_SECURE=                  # default true in production
SESSION_HOURS=8

# --- LLM (optional; without a key deterministic heuristics are used and reported as engine 'local-heuristic')
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT=30
LLM_PRICE_IN_PER_1K=0
LLM_PRICE_OUT_PER_1K=0

# --- Gmail (Google Cloud Console -> OAuth client, redirect URI: BASE_URL/api/v1/oauth/gmail/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_PUBSUB_TOPIC=             # optional: projects/<id>/topics/<topic> for push notifications

# --- Outlook (Entra ID app registration, redirect URI: BASE_URL/api/v1/oauth/outlook/callback)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common

WEBHOOK_SECRET=                 # shared secret for provider webhooks (Gmail ?token=, Outlook clientState)
WORKER_ENABLED=true
WORKER_THREADS=2
ATTACH_MAX_MB=10
